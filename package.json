{
  "name": "taipei-friendly-food-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch:data": "tsx scripts/fetchFriendlyFoodData.ts",
    "data:fetch:water-refill": "tsx scripts/fetchWaterRefillStores.ts",
    "data:fetch:food-traceability": "tsx scripts/fetchTaipeiFoodTraceabilityProducts.ts",
    "data:fetch:commercial-districts": "tsx scripts/fetchCommercialDistrictIntroductions.ts",
    "data:fetch:green-stores": "tsx scripts/fetchGreenStoreDirectory.ts",
    "data:fetch:restaurant-hygiene-grading": "tsx scripts/fetchRestaurantHygieneGradingRecords.ts",
    "data:fetch:failed-food-inspections": "tsx scripts/fetchFailedFoodInspectionRecords.ts",
    "data:fetch:agricultural-inspections": "tsx scripts/fetchAgriculturalProductInspections.ts",
    "data:fetch:organic-farms": "tsx scripts/fetchOrganicFarms.ts",
    "data:fetch:traditional-markets": "tsx scripts/fetchTraditionalMarkets.ts",
    "data:fetch:supermarkets": "tsx scripts/fetchSupermarkets.ts",
    "data:fetch:temporary-vendor-markets": "tsx scripts/fetchTemporaryVendorMarkets.ts",
    "convert:friendly": "tsx scripts/convertFriendlyStores.ts",
    "convert:restaurants": "tsx scripts/convertRestaurantBusinesses.ts",
    "data:convert:water-refill": "tsx scripts/convertWaterRefillStores.ts",
    "data:convert:food-traceability": "tsx scripts/convertTaipeiFoodTraceabilityProducts.ts",
    "data:convert:commercial-districts": "tsx scripts/convertCommercialDistrictIntroductions.ts",
    "data:convert:green-stores": "tsx scripts/convertGreenStoreDirectory.ts && tsx scripts/buildGreenStoreDirectorySummary.ts",
    "data:convert:restaurant-hygiene-grading": "tsx scripts/convertRestaurantHygieneGradingRecords.ts && tsx scripts/buildRestaurantHygieneGradingSummary.ts",
    "data:convert:failed-food-inspections": "tsx scripts/convertFailedFoodInspectionRecords.ts && tsx scripts/buildFailedFoodInspectionSummary.ts",
    "data:convert:agricultural-inspections": "tsx scripts/convertAgriculturalProductInspections.ts",
    "data:convert:organic-farms": "tsx scripts/convertOrganicFarms.ts && tsx scripts/buildOrganicFarmSummary.ts",
    "data:convert:traditional-markets": "tsx scripts/convertTraditionalMarkets.ts",
    "data:convert:supermarkets": "tsx scripts/convertSupermarkets.ts",
    "data:convert:temporary-vendor-markets": "tsx scripts/convertTemporaryVendorMarkets.ts",
    "build:summaries": "tsx scripts/buildFriendlyFoodSummaries.ts",
    "data:fetch": "npm run fetch:data && npm run data:fetch:water-refill && npm run data:fetch:food-traceability && npm run data:fetch:commercial-districts && npm run data:fetch:green-stores && npm run data:fetch:restaurant-hygiene-grading && npm run data:fetch:failed-food-inspections && npm run data:fetch:agricultural-inspections && npm run data:fetch:organic-farms && npm run data:fetch:temporary-vendor-markets",
    "convert:data": "npm run convert:friendly && npm run convert:restaurants && npm run data:convert:water-refill && npm run build:summaries && npm run data:convert:food-traceability && npm run data:convert:commercial-districts && npm run data:convert:green-stores && npm run data:convert:restaurant-hygiene-grading && npm run data:convert:failed-food-inspections && npm run data:convert:agricultural-inspections && npm run data:convert:organic-farms && npm run data:convert:temporary-vendor-markets",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
